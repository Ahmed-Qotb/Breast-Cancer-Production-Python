# Base image
FROM python:3.12-slim

# Switch to root for installs; the runtime uses numeric UID 1001
USER root

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Work directory
WORKDIR /app

# Install dependencies from the lockfile
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-cache

# Copy source code and model artifact
COPY --chown=1001:0 production_app ./production_app
COPY --chown=1001:0 models ./models

ENV PATH="/app/.venv/bin:$PATH"

# Switch user
USER 1001

# FastAPI port
EXPOSE 8000

# Run FastAPI
CMD ["uvicorn", "production_app.api:app", "--host", "0.0.0.0", "--port", "8000"]
